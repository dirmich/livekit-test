version: '3'

services:
  app:
    image: dirmich/highmaru-chat:latest
    container_name: highmaru-chat
    restart: always
    ports:
      - "3000:3000"
    env_file:
      - .env.docker

    networks:
      frontend:
        ipv4_address: 10.0.0.61
networks:
  frontend:
    name: frontend
    external: true
  backend:
    name: backend
    external: true